{
  "title": "API Metrics",
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "pluginId": "prometheus",
        "label": "Prometheus"
      }
    ]
  },
  "panels": [
    {
      "type": "graph",
      "title": "Cache Hits vs Cache Misses",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by (componente) (api_cache_hit_total{componente=\"api\"})",
          "legendFormat": "Cache Hits"
        },
        {
          "expr": "sum by (componente) (api_cache_miss_total{componente=\"api\"})",
          "legendFormat": "Cache Misses"
        }
      ],
      "datasource": "${DS_PROMETHEUS}"
    },
    {
      "type": "graph",
      "title": "Tiempo de Procesamiento por Endpoint (promedio, máximo y mínimo)",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "rate(api_tiempo_procesamiento_segundos_sum{componente=\"api\"}[1m]) / rate(api_tiempo_procesamiento_segundos_count{componente=\"api\"}[1m])",
          "legendFormat": "{{endpoint}} Promedio"
        },
        {
          "expr": "max_over_time(api_tiempo_procesamiento_segundos_sum{componente=\"api\"}[1m])",
          "legendFormat": "{{endpoint}} Máximo"
        },
        {
          "expr": "min_over_time(api_tiempo_procesamiento_segundos_sum{componente=\"api\"}[1m])",
          "legendFormat": "{{endpoint}} Mínimo"
        }
      ],
      "datasource": "${DS_PROMETHEUS}"
    },
    {
      "type": "table",
      "title": "Total de Peticiones por Endpoint",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by (endpoint) (api_total_peticiones_endpoint_total{componente=\"api\"})",
          "legendFormat": "{{endpoint}}"
        }
      ],
      "datasource": "${DS_PROMETHEUS}",
      "options": {
        "showHeader": true
      }
    }
  ],
  "schemaVersion": 39,
  "version": 1
}

