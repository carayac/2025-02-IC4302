{
  "title": "API Metrics",
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "pluginId": "prometheus",
        "label": "Prometheus"
      }
    ]
  },
  "panels": [
    {
      "type": "graph",
      "title": "Cache Hits vs Cache Misses",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by (componente) (cache_hits_total{componente=\"api\"})",
          "legendFormat": "Cache Hits"
        },
        {
          "expr": "sum by (componente) (cache_misses_total{componente=\"api\"})",
          "legendFormat": "Cache Misses"
        }
      ],
      "datasource": "${DS_PROMETHEUS}"
    },
    {
      "type": "graph",
      "title": "Tiempo de Procesamiento (máximo, mínimo y promedio)",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "rate(tiempo_procesamiento_sum{componente=\"api\"}[1m]) / rate(tiempo_procesamiento_count{componente=\"api\"}[1m])",
          "legendFormat": "Promedio"
        },
        {
          "expr": "max_over_time(tiempo_procesamiento_sum{componente=\"api\"}[1m])",
          "legendFormat": "Máximo"
        },
        {
          "expr": "min_over_time(tiempo_procesamiento_sum{componente=\"api\"}[1m])",
          "legendFormat": "Mínimo"
        }
      ],
      "datasource": "${DS_PROMETHEUS}"
    },
    {
      "type": "table",
      "title": "Total de Peticiones por Endpoint",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by (endpoint) (total_peticiones_http_total{componente=\"api\"})",
          "legendFormat": "{{endpoint}}"
        }
      ],
      "datasource": "${DS_PROMETHEUS}",
      "options": {
        "showHeader": true
      }
    }
  ],
  "schemaVersion": 39,
  "version": 1
}
