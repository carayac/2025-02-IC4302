{
  "title": "Flask + Elasticsearch Metrics",
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "pluginId": "prometheus",
        "label": "Prometheus",
        "query": "prometheus"
      }
    ]
  },
  "panels": [
    {
      "type": "graph",
      "title": "Total Peticiones HTTP (bd=elasticsearch)",
      "targets": [
        {
          "expr": "sum(total_peticiones_http{bd=\"elasticsearch\"})",
          "legendFormat": "Total",
          "interval": ""
        }
      ],
      "datasource": "${DS_PROMETHEUS}"
    },
    {
      "type": "graph",
      "title": "Latencia Promedio (bd=elasticsearch)",
      "targets": [
        {
          "expr": "rate(promedio_tiempo_consulta_sum{bd=\"elasticsearch\"}[1m]) / rate(promedio_tiempo_consulta_count{bd=\"elasticsearch\"}[1m])",
          "legendFormat": "Promedio",
          "interval": ""
        }
      ],
      "datasource": "${DS_PROMETHEUS}"
    },
    {
      "type": "singlestat",
      "title": "Cache Hits (bd=elasticsearch)",
      "targets": [
        {
          "expr": "sum(total_cache_hit{bd=\"elasticsearch\"})",
          "legendFormat": "Hits"
        }
      ],
      "datasource": "${DS_PROMETHEUS}"
    },
    {
      "type": "singlestat",
      "title": "Cache Misses (bd=elasticsearch)",
      "targets": [
        {
          "expr": "sum(total_cache_miss{bd=\"elasticsearch\"})",
          "legendFormat": "Misses"
        }
      ],
      "datasource": "${DS_PROMETHEUS}"
    },
    {
      "type": "table",
      "title": "Estado del Servicio",
      "targets": [
        {
          "expr": "up{job=\"elasticsearch\"}",
          "legendFormat": "Estado"
        }
      ],
      "datasource": "${DS_PROMETHEUS}"
    }
  ]
}