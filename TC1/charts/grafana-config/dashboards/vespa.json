{
  "title": "VespaAI Metrics",
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "pluginId": "prometheus",
        "label": "Prometheus"
      }
    ]
  },
  "panels": [
    {
      "type": "graph",
      "title": "Total Peticiones HTTP",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 10},
      "targets": [
        {
          "expr": "sum by (cache) (total_peticiones_http_total{bd=\"vespaai\"})",
          "legendFormat": "{{cache}}"
        }
      ],
      "datasource": "${DS_PROMETHEUS}"
    },
    {
      "type": "graph",
      "title": "Latencia Promedio",
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 10},
      "targets": [
        {
          "expr": "rate(promedio_tiempo_consulta_sum{bd=\"vespaai\"}[1m]) / rate(promedio_tiempo_consulta_count{bd=\"vespaai\"}[1m])",
          "legendFormat": "{{cache}}"
        }
      ],
      "datasource": "${DS_PROMETHEUS}"
    },
    {
      "type": "stat",
      "title": "Cache Hits",
      "gridPos": {"x": 0, "y": 10, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "sum by (cache) (total_cache_hit_total{bd=\"vespaai\"})",
          "legendFormat": "{{cache}}",
          "format": "none"
        }
      ],
      "datasource": "${DS_PROMETHEUS}",
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"],
          "fields": ""
        },
        "orientation": "horizontal",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "type": "stat",
      "title": "Cache Misses",
      "gridPos": {"x": 12, "y": 10, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "sum by (cache) (total_cache_miss_total{bd=\"vespaai\"})",
          "legendFormat": "{{cache}}",
          "format": "none"
        }
      ],
      "datasource": "${DS_PROMETHEUS}",
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"],
          "fields": ""
        },
        "orientation": "horizontal",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    }
  ]
}
