{
  "title": "ChromaDB Metrics",
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "pluginId": "prometheus",
        "label": "Prometheus"
      }
    ]
  },
  "panels": [
    {
      "type": "graph",
      "title": "Total Peticiones HTTP",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 10},
      "targets": [
        {"expr": "sum by (cache) (total_peticiones_http_total{bd=\"chromadb\"})", "legendFormat": "{{cache}}"}
      ],
      "datasource": "${DS_PROMETHEUS}"
    },
    {
      "type": "graph",
      "title": "Latencia Promedio",
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 10},
      "targets": [
        {"expr": "rate(promedio_tiempo_consulta_sum{bd=\"chromadb\"}[1m]) / rate(promedio_tiempo_consulta_count{bd=\"chromadb\"}[1m])", "legendFormat": "{{cache}}"}
      ],
      "datasource": "${DS_PROMETHEUS}"
    },
    {
      "type": "stat",
      "title": "Cache Hits",
      "gridPos": {"x": 0, "y": 10, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum by (cache) (total_cache_hit_total{bd=\"chromadb\"})", "legendFormat": "{{cache}}", "format": "none"}
      ],
      "datasource": "${DS_PROMETHEUS}",
      "options": {
        "reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""},
        "orientation": "horizontal",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "type": "stat",
      "title": "Cache Misses",
      "gridPos": {"x": 12, "y": 10, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum by (cache) (total_cache_miss_total{bd=\"chromadb\"})", "legendFormat": "{{cache}}", "format": "none"}
      ],
      "datasource": "${DS_PROMETHEUS}",
      "options": {
        "reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""},
        "orientation": "horizontal",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "type": "graph",
      "title": "Uso de CPU (%)",
      "gridPos": {"x": 0, "y": 18, "w": 12, "h": 8},
      "targets": [{"expr": "system_cpu_usage_percent{bd=\"chromadb\"}", "legendFormat": "CPU"}],
      "datasource": "${DS_PROMETHEUS}"
    },
    {
      "type": "graph",
      "title": "Uso de Memoria (%)",
      "gridPos": {"x": 12, "y": 18, "w": 12, "h": 8},
      "targets": [{"expr": "system_memory_usage_percent{bd=\"chromadb\"}", "legendFormat": "Memoria"}],
      "datasource": "${DS_PROMETHEUS}"
    },
    {
      "type": "graph",
      "title": "Uso de Disco (%)",
      "gridPos": {"x": 0, "y": 26, "w": 12, "h": 8},
      "targets": [{"expr": "system_disk_usage_percent{bd=\"chromadb\"}", "legendFormat": "Disco"}],
      "datasource": "${DS_PROMETHEUS}"
    },
    {
      "type": "graph",
      "title": "Tráfico de Red - Enviados",
      "gridPos": {"x": 12, "y": 26, "w": 12, "h": 8},
      "targets": [{"expr": "rate(system_network_sent_bytes{bd=\"chromadb\"}[1m])", "legendFormat": "Enviados"}],
      "datasource": "${DS_PROMETHEUS}"
    },
    {
      "type": "graph",
      "title": "Tráfico de Red - Recibidos",
      "gridPos": {"x": 0, "y": 34, "w": 12, "h": 8},
      "targets": [{"expr": "rate(system_network_received_bytes{bd=\"chromadb\"}[1m])", "legendFormat": "Recibidos"}],
      "datasource": "${DS_PROMETHEUS}"
    },
    {
      "type": "stat",
      "title": "Conexiones Abiertas",
      "gridPos": {"x": 12, "y": 34, "w": 12, "h": 8},
      "targets": [{"expr": "system_open_connections{bd=\"chromadb\"}", "legendFormat": "Conexiones"}],
      "datasource": "${DS_PROMETHEUS}",
      "options": {
        "reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""},
        "orientation": "horizontal",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center"
      }
    },
    {
      "type": "stat",
      "title": "Descriptores de Archivos",
      "gridPos": {"x": 0, "y": 42, "w": 12, "h": 8},
      "targets": [{"expr": "system_file_descriptors{bd=\"chromadb\"}", "legendFormat": "FDs"}],
      "datasource": "${DS_PROMETHEUS}"
    },
    {
      "type": "stat",
      "title": "IOPS",
      "gridPos": {"x": 12, "y": 42, "w": 12, "h": 8},
      "targets": [{"expr": "system_iops{bd=\"chromadb\"}", "legendFormat": "IOPS"}],
      "datasource": "${DS_PROMETHEUS}"
    },
    {
      "type": "graph",
      "title": "Consultas por Segundo",
      "gridPos": {"x": 0, "y": 50, "w": 12, "h": 8},
      "targets": [{"expr": "chromadb_queries_per_second", "legendFormat": "QPS"}],
      "datasource": "${DS_PROMETHEUS}"
    },
    {
      "type": "graph",
      "title": "Tiempo de Respuesta de Consultas (s)",
      "gridPos": {"x": 12, "y": 50, "w": 12, "h": 8},
      "targets": [{"expr": "chromadb_query_response_time_seconds", "legendFormat": "Query Response"}],
      "datasource": "${DS_PROMETHEUS}"
    },
    {
      "type": "stat",
      "title": "Threads Activos en Pool",
      "gridPos": {"x": 0, "y": 58, "w": 12, "h": 8},
      "targets": [{"expr": "chromadb_thread_pool_active", "legendFormat": "Threads"}],
      "datasource": "${DS_PROMETHEUS}"
    }
  ]
}

