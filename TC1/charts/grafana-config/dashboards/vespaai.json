{
  "title": "VespaAI Metrics",
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "pluginId": "prometheus",
        "label": "Prometheus"
      }
    ]
  },
  "panels": [
    {
      "type": "graph",
      "title": "Total Peticiones HTTP",
      "targets": [
        {
          "expr": "sum by (cache) (total_peticiones_http{bd=\"vespaai\"})",
          "legendFormat": "{{cache}}"
        }
      ],
      "datasource": "${DS_PROMETHEUS}"
    },
    {
      "type": "graph",
      "title": "Latencia Promedio",
      "targets": [
        {
          "expr": "rate(promedio_tiempo_consulta_sum{bd=\"vespaai\"}[1m]) / rate(promedio_tiempo_consulta_count{bd=\"vespaai\"}[1m])",
          "legendFormat": "{{cache}}"
        }
      ],
      "datasource": "${DS_PROMETHEUS}"
    },
    {
      "type": "singlestat",
      "title": "Cache Hits",
      "targets": [
        {
          "expr": "sum(total_cache_hit{bd=\"vespaai\"})",
          "legendFormat": "Hits"
        }
      ],
      "datasource": "${DS_PROMETHEUS}"
    },
    {
      "type": "singlestat",
      "title": "Cache Misses",
      "targets": [
        {
          "expr": "sum(total_cache_miss{bd=\"vespaai\"})",
          "legendFormat": "Misses"
        }
      ],
      "datasource": "${DS_PROMETHEUS}"
    },
    {
      "type": "table",
      "title": "Estado del Servicio",
      "targets": [
        {
          "expr": "up{job=\"vespaai\"}",
          "legendFormat": "Estado"
        }
      ],
      "datasource": "${DS_PROMETHEUS}"
    }
  ]
}
